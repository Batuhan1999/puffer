diff --git a/node_modules/react-native-enriched-html/ios/styles/HighlightStyle.mm b/node_modules/react-native-enriched-html/ios/styles/HighlightStyle.mm
new file mode 100644
index 0000000..13efb83
--- /dev/null
+++ b/node_modules/react-native-enriched-html/ios/styles/HighlightStyle.mm
@@ -0,0 +1,104 @@
+#import "AttributeEntry.h"
+#import "EnrichedTextInputView.h"
+#import "RangeUtils.h"
+#import "StyleHeaders.h"
+
+// Apple Notes' highlight colors. The attribute value is the color's name, the
+// same string <mark data-color="..."> carries.
+@implementation HighlightStyle
+
++ (StyleType)getType {
+  return Highlight;
+}
+
+- (NSString *)getKey {
+  return @"EnrichedHighlight";
+}
+
+- (BOOL)isParagraph {
+  return NO;
+}
+
++ (UIColor *)colorForName:(NSString *)name {
+  UIColor *base = [name isEqualToString:@"pink"]     ? UIColor.systemPinkColor
+                  : [name isEqualToString:@"orange"] ? UIColor.systemOrangeColor
+                  : [name isEqualToString:@"mint"]   ? UIColor.systemMintColor
+                  : [name isEqualToString:@"blue"]   ? UIColor.systemBlueColor
+                                                     : UIColor.systemPurpleColor;
+  return [base colorWithAlphaComponent:0.3];
+}
+
+- (BOOL)styleCondition:(id)value range:(NSRange)range {
+  return [value isKindOfClass:NSString.class];
+}
+
+- (void)applyStyling:(NSRange)range {
+  NSTextStorage *storage = self.host.textView.textStorage;
+  [storage enumerateAttribute:[self getKey]
+                      inRange:range
+                      options:0
+                   usingBlock:^(id value, NSRange sub, BOOL *stop) {
+                     if (![value isKindOfClass:NSString.class])
+                       return;
+                     for (NSValue *v in [RangeUtils
+                              getNonNewlineRangesIn:self.host.textView
+                                              range:sub]) {
+                       [storage
+                           addAttribute:NSBackgroundColorAttributeName
+                                  value:[HighlightStyle colorForName:value]
+                                  range:v.rangeValue];
+                     }
+                   }];
+}
+
+- (void)reapplyFromStylePair:(StylePair *)pair {
+  [self add:pair.rangeValue.rangeValue
+           withValue:pair.styleValue
+          withTyping:NO
+      withDirtyRange:NO];
+}
+
+// Typing right after highlighted text continues its color.
+- (AttributeEntry *)getEntryIfPresent:(NSRange)range {
+  if (![self detect:range])
+    return nullptr;
+  NSTextStorage *storage = self.host.textView.textStorage;
+  BOOL caret = range.length == 0 &&
+               NSEqualRanges(self.host.textView.selectedRange, range);
+  id value = caret || range.location >= storage.length
+                 ? self.host.textView.typingAttributes[[self getKey]]
+                 : [storage attribute:[self getKey]
+                              atIndex:range.location
+                       effectiveRange:nil];
+  if (![value isKindOfClass:NSString.class])
+    return nullptr;
+  AttributeEntry *entry = [[AttributeEntry alloc] init];
+  entry.key = [self getKey];
+  entry.value = value;
+  return entry;
+}
+
+// Same color everywhere in the range removes it; otherwise the range takes it.
+- (void)toggleWithColor:(NSString *)color range:(NSRange)range {
+  if (range.length == 0) {
+    [self.host.textView.typingAttributes[[self getKey]] isEqual:color]
+        ? [self removeTyping]
+        : [self addTypingWithValue:color];
+    return;
+  }
+  __block BOOL same = YES;
+  [self.host.textView.textStorage
+      enumerateAttribute:[self getKey]
+                 inRange:range
+                 options:0
+              usingBlock:^(id value, NSRange sub, BOOL *stop) {
+                if (![value isEqual:color]) {
+                  same = NO;
+                  *stop = YES;
+                }
+              }];
+  same ? [self remove:range withDirtyRange:YES]
+       : [self add:range withValue:color withTyping:YES withDirtyRange:YES];
+}
+
+@end
