{
  "expo": {
    "name": "Puffer",
    "slug": "prototype",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "dev.local.puffer",
      "appleTeamId": "6Z8WY4U8PP"
    },
    "plugins": [
      "expo-sqlite",
      "expo-font",
      "expo-router",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "18.0"
          }
        }
      ],
      "./modules/puffer-native/app.plugin.js"
    ],
    "scheme": "puffer",
    "platforms": [
      "ios"
    ]
  }
}
